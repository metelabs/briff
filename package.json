{
  "name": "briff",
  "version": "0.8.0",
  "description": "Weekly dependency briefing and same-day security alerts derived from your repositories' lockfiles and runtime files.",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Fikret Yunus Yildiz",
  "homepage": "https://github.com/metelabs/briff#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metelabs/briff.git"
  },
  "bugs": {
    "url": "https://github.com/metelabs/briff/issues"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:local": "tsx scripts/scan-local.ts",
    "email:preview": "tsx --conditions=react-server --env-file-if-exists=.env scripts/preview-email.ts",
    "replay": "tsx --conditions=react-server scripts/replay.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.10.0",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "^7.8.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "smol-toml": "^1.8.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
