# Every variable is read at runtime. Nothing here is needed at `docker build` time,
# and there are no NEXT_PUBLIC_* variables.

# --- Required ---------------------------------------------------------------
# Postgres connection string (on a PaaS: the database service's internal connection URL).
DATABASE_URL=postgresql://briff:briff@localhost:55432/briff

# Session signing secret, at least 32 chars. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public origin of the web app (used for auth callbacks and cookie scope).
BETTER_AUTH_URL=https://app.briff.dev

# --- Access -----------------------------------------------------------------
# The first account can always be created (it bootstraps the instance).
# Registration is open by default. Set false to close it after the first account.
ALLOW_SIGNUP=true

# Deprecated: scanners authenticate with per-org scan tokens created in Settings -> Scan
# tokens (BRIFF_TOKEN on the scanner side). This instance-wide token still works as a
# fallback and logs a warning on every upload; remove it once no scanner sends it
# (docs/SCANNER.md, "Switch from SCANNER_TOKEN"). At least 24 chars.
SCANNER_TOKEN=

# Deprecated with SCANNER_TOKEN: the org its uploads belong to. Only needed once more
# than one org exists.
SCANNER_ORG_ID=

# --- Integrations ------------------------------------------------------------
# Missing ones disable a feature (reported by /api/health) instead of crashing.

# Anthropic API key for triage (Haiku) and weekly synthesis (Sonnet).
# console.anthropic.com -> Settings -> API keys. Without it, triage and the bulletin are skipped.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown).
BRIFF_MODEL_TRIAGE=claude-haiku-5-5
BRIFF_MODEL_SYNTHESIS=claude-sonnet-5-5

# Brevo SMTP relay: bulletins, security alerts, urgent items. Brevo -> SMTP & API -> SMTP tab
# (login = SMTP_USER, an SMTP key = SMTP_PASS). Any SMTP relay works; a 535 means a wrong key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address; its domain must be verified in Brevo (Senders, domains -> Domains).
FROM_EMAIL=

# Send weekly synthesis and triage through the Message Batches API (default true): 50% of the
# token price, results within minutes (polled every 30s, up to 60 min). "false" = one call per request.
BRIFF_LLM_BATCH=true

# Email security items right after triage (and runtime security items right after
# collect-sources, without the LLM) instead of waiting for Monday (default true).
BRIFF_URGENT_EMAIL=true

# Optional error reporting (server + worker only).
SENTRY_DSN=

# Optional: raises GitHub rate limits for release feeds and the hourly security-advisories
# API calls (60/h unauthenticated). Fine-grained PAT, public read-only.
GITHUB_TOKEN=

# Optional: the Briff GitHub App ("Connect GitHub": scans repos on install and on every push,
# no token or workflow for the user). All six or none; set them on web AND worker.
# Runbook: docs/GITHUB-APP.md ("Runbook: create the app").
GITHUB_APP_ID=
# The app's URL slug: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# The app's private key: `base64 -w0 key.pem`, or the PEM with \n for newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# OAuth client of the app: proves the installing user can access the installation.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional: debug | info | warn | error (default: info in production, debug otherwise).
LOG_LEVEL=

# Unused today: read only by the Product Hunt client in src/lib/platforms/producthunt.ts,
# which no job calls yet. Leave empty.
PRODUCTHUNT_API_KEY=
PRODUCTHUNT_API_SECRET=

# Optional: User-Agent for feed requests (default "Mozilla/5.0 (compatible; Briff/1.0;
# +https://briff.dev)"). Set it to name your own instance.
BRIFF_RSS_USER_AGENT=

# --- Container ----------------------------------------------------------------
# The web role applies pending migrations on start; "false" skips it (run
# `prisma migrate deploy` yourself). The worker never migrates.
MIGRATE_ON_START=true
# The image sets NODE_ENV=production, PORT=3000 and HOSTNAME=0.0.0.0; keep the port at 3000.

# Development only: deterministic stand-in for the Anthropic API (refused when NODE_ENV=production).
# BRIFF_LLM_FAKE=true
