# Briff self-hosting configuration for compose.yaml (docs/SELF-HOSTING.md).
#   cp .env.selfhost.example .env && chmod 600 .env
# Every value is read at runtime by web and worker; nothing is baked into the image.
# Restart after a change: docker compose up -d

# --- Required -----------------------------------------------------------------
# Postgres password for the bundled postgres service. compose.yaml builds DATABASE_URL
# from it, so use URL-safe characters: openssl rand -hex 24
POSTGRES_PASSWORD=

# Session signing secret, at least 32 chars: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public origin of the web app, exactly as the browser shows it (scheme, host, port if
# not 443/80). Sign-in fails with "Invalid origin" when it does not match.
BETTER_AUTH_URL=https://briff.example.com

# The first account owns the instance (the Admin page). Registration is open by default;
# set false after you created your account to close it (the first account is always allowed).
ALLOW_SIGNUP=true

# --- Compose ------------------------------------------------------------------
# Image and tag. Pin a release (e.g. 0.7.3) instead of latest; web and worker always run
# the same tag. BRIFF_IMAGE is only for testing a locally built image.
BRIFF_VERSION=latest
BRIFF_IMAGE=ghcr.io/metelabs/briff
# Host address and port the web service is published on. Keep 127.0.0.1 behind a
# reverse proxy; change the port when 3000 is taken on this host.
BRIFF_BIND=127.0.0.1
BRIFF_WEB_PORT=3000
# Compose project name: containers, network and the database volume are prefixed with it.
# Give a second stack on the same host a different name.
COMPOSE_PROJECT_NAME=briff

# --- Email (optional) ---------------------------------------------------------
# Any SMTP relay. All five or nothing is emailed (bulletins, security alerts, urgent items);
# the web app still shows everything. Port 465 uses TLS, others STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address; its domain must be verified at your relay.
FROM_EMAIL=
# Email security items right after triage / collection instead of waiting for Monday.
BRIFF_URGENT_EMAIL=true

# --- LLM (optional) -----------------------------------------------------------
# Anthropic API key for triage (Haiku) and the weekly synthesis (Sonnet). Without it there
# is no triage and no weekly bulletin; security alerts and urgent runtime emails still run.
ANTHROPIC_API_KEY=
BRIFF_MODEL_TRIAGE=claude-haiku-5-5
BRIFF_MODEL_SYNTHESIS=claude-sonnet-5-5
# Message Batches API: 50% of the token price, results within minutes. false = direct calls.
BRIFF_LLM_BATCH=true

# --- GitHub App (optional) ----------------------------------------------------
# "Connect GitHub": scans repos on install and on every push. All six or none.
# Create your own app: docs/GITHUB-APP.md ("Runbook: create the app").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# base64 -w0 key.pem, or the PEM with \n for newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Raises GitHub rate limits for release feeds and security-advisory calls (60/h without).
# Fine-grained PAT, public repositories read-only.
GITHUB_TOKEN=

# --- Scanner (optional, deprecated) -------------------------------------------
# Scanners use per-org scan tokens from Settings -> Scan tokens (docs/SCANNER.md). This
# instance-wide fallback token (24+ chars) logs a warning on every upload; leave it empty.
SCANNER_TOKEN=
SCANNER_ORG_ID=

# --- Operations (optional) ----------------------------------------------------
# The web role applies pending migrations on start; false skips it.
MIGRATE_ON_START=true
# debug | info | warn | error (default info).
LOG_LEVEL=
# User-Agent for feed requests; name your own instance.
BRIFF_RSS_USER_AGENT=
